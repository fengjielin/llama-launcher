# 依赖与构建产物（core 零依赖，这些只在 M2 引入 Electron 后才出现）
node_modules/
dist/
out/
release/
# 输出目录被占用时，打包会退到带时间戳的备用目录（见 scripts/package.mjs）
dist-fallback-*/
# 打包用的 Electron 发行目录过滤镜像（硬链接，见 scripts/package.mjs）
.electron-dist/

# 本地配置与日志：含本机路径，不入库
llama-launcher.json
*.log
*.local.json

# 配置档案：是用户自己的机器与模型路径，不入库
profiles/

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 改配置时的就地备份（见 README 的配置说明）
*.bak-*
